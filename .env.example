# ╔══════════════════════════════════════════════╗
# ║  AgriConnect — Variables d'environnement     ║
# ╚══════════════════════════════════════════════╝

# Base de données PostgreSQL
#DATABASE_URL="postgresql://user:password@localhost:5432/agriconnect?schema=public"

DATABASE_URL="postgresql://user:password@localhost:5432/ladini"



# Secret pour la création de comptes Admin (OBLIGATOIRE)
# Changez cette valeur et gardez-la secrète !
ADMIN_REGISTRATION_SECRET=change_me

# Environnement
NODE_ENV="development"

# URL de l'application (pour les API côté serveur)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Webchat Ladini (sections buyer/producer, partagé avec WhatsApp)
# Secret serveur fourni par l'équipe Ladini — NE JAMAIS préfixer par NEXT_PUBLIC_,
# NE JAMAIS l'exposer côté navigateur (voir lib/ladini-chat.ts).
LADINI_INTERNAL_TOKEN=""

# ── Cockpit /admin/monitoring (lecture des métriques de l'agent) ───────────────────────────────────
# Optionnel : URL de la sonde de readiness du backend Python (API + PostgreSQL + Valkey vus du backend). Elle alimente la ligne
# « API » de l'onglet Santé. Doit être joignable DEPUIS LE SERVEUR Next.js (pas le navigateur) : URL publique de l'API,
# ex. https://api.ladini.example/health/ready. Non défini = la sonde API reste « UNKNOWN » (jamais présentée comme saine).
MONITORING_BACKEND_HEALTH_URL=https://api.ladini.tech/health/ready
# Optionnel : modèle de lien vers une trace Langfuse, {traceId} est remplacé par l'identifiant de trace du tour
# (bouton « Trace » dans la timeline d'une session). Ex. https://cloud.langfuse.com/project/<ID_PROJET>/traces/{traceId}
# Non défini = pas de lien (le cockpit fonctionne sans Langfuse).
LANGFUSE_TRACE_URL_TEMPLATE=
# Optionnel : seuils HEALTHY/DEGRADED/CRITICAL et de session, en JSON PARTIEL (fusionné avec les défauts). Ex. :
# MONITORING_THRESHOLDS={"toolErrorRate":{"degraded":0.05,"critical":0.15},"turnP95Ms":{"degraded":5000,"critical":10000},"stalledMinutes":10,"abandonedMinutes":30}
# Clés : toolErrorRate, llmErrorRate, turnP95Ms, dbP95Ms, redisP95Ms, whatsappFailureRate, turnErrorRate, workflowFailureRate,
# stalledMinutes, abandonedMinutes, activeMinutes, workerSilenceMinutes. Vide = défauts.
MONITORING_THRESHOLDS=
